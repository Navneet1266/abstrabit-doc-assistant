# Postgres connection string (Supabase: Project Settings -> Database -> Connection string,
# use the "Session pooler" or direct connection URI; local: matches docker-compose.yml below)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google AI Studio (https://aistudio.google.com/apikey) - free tier, no card required
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Discord incoming webhook URL for the notify_discord tool (optional - the tool
# reports a clean error instead of crashing if this is unset)
DISCORD_WEBHOOK_URL=

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

RETRIEVAL_TOP_K=6
MAX_TOOL_ROUNDS=3
