# Base URL of the deployed (or locally running) FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# Supabase project (Project Settings -> API). The anon key is safe to expose
# in a frontend bundle by design - it only grants what your Supabase auth/RLS
# rules allow, and is not the service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
